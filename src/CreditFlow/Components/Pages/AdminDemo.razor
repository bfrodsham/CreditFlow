@page "/admin-demo"
@rendermode InteractiveServer
@using CreditFlow.Components.Services
@using CreditFlow.Contracts
@inject DashboardApiClient DashboardApi

<PageTitle>Admin Demo</PageTitle>

<h1>Admin/Demo</h1>

@if (_isLoading)
{
    <p>Loading accounts...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">
        @_error
    </div>
}
else
{
    <div class="card">
        <div class="card-body d-flex flex-column gap-3">
            <div>
                <label class="form-label" for="accountSelector">Account</label>
                <select class="form-select" id="accountSelector" value="@_selectedAccountId" @onchange="OnAccountChanged">
                    @foreach (var account in _accounts)
                    {
                        <option value="@account.Id">@account.Name (@account.Email)</option>
                    }
                </select>
            </div>

            <div>
                <h2 class="h5 mb-1">Current Balance</h2>
                @if (_isLoadingBalance)
                {
                    <p class="mb-0">Loading balance...</p>
                }
                else if (_balance is null)
                {
                    <p class="mb-0">Select an account to view balance.</p>
                }
                else
                {
                    <p class="display-6 mb-0">@_balance credits</p>
                }
            </div>

            <div>
                <h2 class="h5 mb-1">Current Plan</h2>
                @if (_isLoadingPlans || _isLoadingSubscription)
                {
                    <p class="mb-0">Loading plan details...</p>
                }
                else if (_subscription is null)
                {
                    <p class="mb-2">No subscription is set for this account.</p>
                }
                else
                {
                    <p class="mb-1"><strong>@_subscription.PlanName</strong> (@_subscription.MonthlyCreditAllowance credits/month)</p>
                    <p class="mb-2 text-muted">
                        Rollover: @(_subscription.AllowsRollover ? "Enabled" : "Disabled")
                        |
                        Renews @(_subscription.CurrentPeriodEnd.ToString("yyyy-MM-dd"))
                    </p>
                }

                @if (_plans.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var plan in _plans)
                        {
                            var isCurrent = _subscription?.PlanId == plan.Id;
                            var isUpdatingThisPlan = _isUpdatingPlan && _pendingPlanId == plan.Id;

                            <button
                                class="btn @(isCurrent ? "btn-outline-secondary" : "btn-outline-primary")"
                                disabled="@(_selectedAccountId is null || _isUpdatingPlan || isCurrent)"
                                @onclick="() => ChangePlanAsync(plan.Id)">
                                @(isUpdatingThisPlan ? $"Switching to {plan.Name}..." : isCurrent ? $"{plan.Name} (Current)" : $"Switch to {plan.Name}")
                            </button>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_planMessage))
                {
                    <p class="mb-0 mt-2">@_planMessage</p>
                }

                <p class="mb-0 mt-2 text-muted">Background subscription renewal checks run every 20 seconds.</p>
            </div>

            <div class="d-flex flex-column gap-2 align-items-start">
                <button class="btn btn-primary" @onclick="SimulateUsageEventAsync" disabled="@(_selectedAccountId is null || _isSimulatingUsage)">
                    @(_isSimulatingUsage ? "Simulating usage..." : "Simulate Usage Event")
                </button>

                @if (!string.IsNullOrWhiteSpace(_usageMessage))
                {
                    <p class="mb-0">@_usageMessage</p>
                }
            </div>

            <div class="d-flex flex-column gap-2 align-items-start">
                <button class="btn btn-warning" @onclick="SimulatePaymentWebhookAsync" disabled="@(_selectedAccountId is null || _isSubmitting)">
                    @(_isSubmitting ? "Simulating payment webhook..." : "Simulate Payment Webhook")
                </button>

                @if (!string.IsNullOrWhiteSpace(_webhookMessage))
                {
                    <p class="mb-0">@_webhookMessage</p>
                }
            </div>

            <div class="d-flex flex-column gap-2 align-items-start">
                <button class="btn btn-success" @onclick="ApplyRenewalNowForSelectedAccountAsync" disabled="@(_selectedAccountId is null || _isApplyingSelectedRenewal)">
                    @(_isApplyingSelectedRenewal ? "Applying renewal now..." : "Apply Renewal Now (Selected Account)")
                </button>

                <button class="btn btn-outline-success" @onclick="QueueRenewalForAllAccountsAsync" disabled="@_isQueueingAllRenewals">
                    @(_isQueueingAllRenewals ? "Queueing renewals..." : "Queue Renewal For All Accounts (Runs On Next Background Check)")
                </button>

                @if (!string.IsNullOrWhiteSpace(_renewalMessage))
                {
                    <p class="mb-0">@_renewalMessage</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<AccountSummaryDto> _accounts = [];
    private List<PlanDto> _plans = [];
    private Guid? _selectedAccountId;
    private Guid? _pendingPlanId;
    private int? _balance;
    private SubscriptionDto? _subscription;
    private bool _isLoading = true;
    private bool _isLoadingBalance;
    private bool _isLoadingPlans;
    private bool _isLoadingSubscription;
    private bool _isSimulatingUsage;
    private bool _isSubmitting;
    private bool _isUpdatingPlan;
    private bool _isApplyingSelectedRenewal;
    private bool _isQueueingAllRenewals;
    private string? _error;
    private string? _planMessage;
    private string? _usageMessage;
    private string? _webhookMessage;
    private string? _renewalMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await DashboardApi.GetAccountsAsync();
            _isLoadingPlans = true;
            _plans = await DashboardApi.GetPlansAsync();
            _selectedAccountId = _accounts.FirstOrDefault()?.Id;

            if (_selectedAccountId is not null)
            {
                await LoadAccountSnapshotAsync(_selectedAccountId.Value);
            }
        }
        catch
        {
            _error = "Unable to load account data.";
        }
        finally
        {
            _isLoadingPlans = false;
            _isLoading = false;
        }
    }

    private async Task OnAccountChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var accountId))
        {
            return;
        }

        _selectedAccountId = accountId;
        _planMessage = null;
        _usageMessage = null;
        _webhookMessage = null;
        _renewalMessage = null;
        await LoadAccountSnapshotAsync(accountId);
    }

    private async Task LoadAccountSnapshotAsync(Guid accountId)
    {
        await LoadBalanceAsync(accountId);
        await LoadSubscriptionAsync(accountId);
    }

    private async Task LoadBalanceAsync(Guid accountId)
    {
        _isLoadingBalance = true;
        _error = null;

        try
        {
            var response = await DashboardApi.GetBalanceAsync(accountId);
            _balance = response?.Balance;
        }
        catch
        {
            _error = "Unable to load balance for the selected account.";
            _balance = null;
        }
        finally
        {
            _isLoadingBalance = false;
        }
    }

    private async Task LoadSubscriptionAsync(Guid accountId)
    {
        _isLoadingSubscription = true;
        _error = null;

        try
        {
            _subscription = await DashboardApi.GetSubscriptionAsync(accountId);
        }
        catch
        {
            _error = "Unable to load subscription for the selected account.";
            _subscription = null;
        }
        finally
        {
            _isLoadingSubscription = false;
        }
    }

    private async Task ChangePlanAsync(Guid planId)
    {
        if (_selectedAccountId is null)
        {
            return;
        }

        _isUpdatingPlan = true;
        _pendingPlanId = planId;
        _error = null;
        _planMessage = null;

        try
        {
            _subscription = await DashboardApi.UpdatePlanAsync(_selectedAccountId.Value, planId);
            _planMessage = _subscription is null
                ? "Plan updated."
                : $"Plan updated to {_subscription.PlanName}.";
        }
        catch
        {
            _error = "Unable to update plan for the selected account.";
        }
        finally
        {
            _isUpdatingPlan = false;
            _pendingPlanId = null;
        }
    }

    private async Task SimulatePaymentWebhookAsync()
    {
        if (_selectedAccountId is null)
        {
            return;
        }

        _isSubmitting = true;
        _error = null;
        _webhookMessage = null;

        try
        {
            var result = await DashboardApi.SimulatePaymentWebhookAsync(_selectedAccountId.Value, 100, null, "Simulated webhook grant", CancellationToken.None);
            _webhookMessage = result is null
                ? "Payment webhook processed."
                : result.AlreadyProcessed
                    ? "Payment webhook already processed for this idempotency key."
                    : $"Granted {result.CreditsGranted} credits from simulated webhook.";

            await LoadBalanceAsync(_selectedAccountId.Value);
        }
        catch
        {
            _error = "Unable to simulate payment webhook for the selected account.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ApplyRenewalNowForSelectedAccountAsync()
    {
        if (_selectedAccountId is null)
        {
            return;
        }

        _isApplyingSelectedRenewal = true;
        _error = null;
        _renewalMessage = null;

        try
        {
            var result = await DashboardApi.RenewSelectedAccountNowAsync(_selectedAccountId.Value);
            _renewalMessage = result is null
                ? "Renewal was requested for the selected account."
                : result.RenewalsProcessed > 0
                    ? "Renewal applied immediately for the selected account."
                    : "No renewal was due for the selected account.";

            await LoadAccountSnapshotAsync(_selectedAccountId.Value);
        }
        catch
        {
            _error = "Unable to apply renewal for the selected account.";
        }
        finally
        {
            _isApplyingSelectedRenewal = false;
        }
    }

    private async Task QueueRenewalForAllAccountsAsync()
    {
        _isQueueingAllRenewals = true;
        _error = null;
        _renewalMessage = null;

        try
        {
            var result = await DashboardApi.QueueRenewalForAllAccountsAsync();
            _renewalMessage = result is null
                ? "Renewal was queued for all accounts."
                : $"Queued renewal for {result.AccountsQueued} account(s). The background job will apply these on its next check.";

            if (_selectedAccountId is not null)
            {
                await LoadSubscriptionAsync(_selectedAccountId.Value);
            }
        }
        catch
        {
            _error = "Unable to queue renewals for all accounts.";
        }
        finally
        {
            _isQueueingAllRenewals = false;
        }
    }

    private async Task SimulateUsageEventAsync()
    {
        if (_selectedAccountId is null)
        {
            return;
        }

        _isSimulatingUsage = true;
        _error = null;
        _usageMessage = null;

        try
        {
            var result = await DashboardApi.SimulateUsageEventAsync(_selectedAccountId.Value, "model-inference", null);
            _usageMessage = result is null
                ? "Usage event recorded."
                : $"Recorded {result.EventType} usage for {result.CreditCost} credits.";

            await LoadBalanceAsync(_selectedAccountId.Value);
        }
        catch
        {
            _error = "Unable to simulate usage for the selected account.";
        }
        finally
        {
            _isSimulatingUsage = false;
        }
    }
}
